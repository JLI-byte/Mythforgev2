{
  "name": "lorecanvas-web",
  "version": "1.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron-dev": "concurrently \"next dev -p 4000\" \"cross-env NODE_ENV=development wait-on http://localhost:4000 && cross-env NODE_ENV=development electron .\"",
    "electron-build": "node scripts/build-electron.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.lorecanvas.app",
    "productName": "LoreCanvas BETA 1.1",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "zip"
      ],
      "publish": null
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/node.exe",
        "to": "node.exe"
      }
    ],
    "protocols": {
      "name": "lorecanvas",
      "schemes": [
        "lorecanvas"
      ]
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tiptap/extension-color": "^3.22.2",
    "@tiptap/extension-font-family": "^3.22.2",
    "@tiptap/extension-highlight": "^3.22.2",
    "@tiptap/extension-image": "^3.20.5",
    "@tiptap/extension-table": "^3.20.5",
    "@tiptap/extension-table-cell": "^3.20.5",
    "@tiptap/extension-table-header": "^3.20.5",
    "@tiptap/extension-table-row": "^3.20.5",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extension-text-style": "^3.22.2",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "docx": "^9.6.0",
    "dompurify": "^3.4.9",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "fs-extra": "^11.3.4",
    "happy-dom": "^15.11.7",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^3.2.6",
    "wait-on": "^9.0.4"
  }
}
