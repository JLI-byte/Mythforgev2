  border-bottom: 2px solid var(--accent);
}

/* Main editor scrollbar — repositioned to left edge via transform */
[data-scroll="main"]::-webkit-scrollbar {
    width: 5px;
}
[data-scroll="main"]::-webkit-scrollbar-track {
    background: transparent;
}
[data-scroll="main"]::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 99px;
}
[data-scroll="main"]::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
}

/* ISO-Hub scrollbar style — 4px, near-black track, dark thumb */
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
::-webkit-scrollbar-track {
  background: #0e0e0e;
}
::-webkit-scrollbar-thumb {
  background: #353534;
  border-radius: 10px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--accent);
}

/* FindReplace ProseMirror decorations — applied by custom FindReplace extension */
.mythforge-search-match {
    background-color: rgba(255, 215, 0, 0.35);
    border-radius: 2px;
}
.mythforge-search-current {
    background-color: rgba(255, 140, 0, 0.55);
    border-radius: 2px;
    outline: 1px solid rgba(255, 140, 0, 0.7);
}
/* @Entity suggest � highlight the @query text while typing */
.entity-suggest-query {
  background: rgba(208, 188, 255, 0.15);
  border-radius: 3px;
  color: var(--accent);
}
